# Copy to .env (never commit .env). Values here are examples only.

APP_ENV=dev
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/vendor_onboarding
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: a shared code that gates the whole site (at least 8 characters). Leave empty for an open demo.
DEMO_ACCESS_CODE=

# Document-reading model, via an OpenAI-compatible endpoint (Gemini by default).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Optional extra keys for the same endpoint and model. Calls rotate through them; a key that hits
# its daily quota, rate limit or is rejected is skipped until it can work again.
LLM_API_KEY_2=
LLM_API_KEY_3=
LLM_MODEL=gemini-3.8-flash

# Optional backups, tried in order when the main model fails or is slow (any OpenAI-compatible endpoint).
# Each backup needs all three settings. Add LLM_FALLBACK_2_* and LLM_FALLBACK_3_* the same way.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Seconds without an answer before a read is handed to the next model (the last one keeps the full timeout).
LLM_HANDOVER_S=90

# Public IFSC directory lookups (set false to work offline)
LIVE_LOOKUPS=true

# Hosting (defaults suit a laptop; render.yaml sets smaller values for a 512 MB instance)
PDF_MAX_CHILDREN=2
PDF_MEMORY_MB=700
DB_POOL_SIZE=5
